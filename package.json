{
  "name": "tray-tasks-obsidian",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "test": "vitest run",
    "tauri": "tauri",
    "desktop:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desktop.ps1 -Mode dev",
    "desktop:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desktop.ps1 -Mode build",
    "desktop:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desktop.ps1 -Mode check",
    "desktop:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desktop.ps1 -Mode test",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"tests/**/*.ts\" \"*.ts\" \"*.json\" \"src-tauri/*.json\" \"src-tauri/capabilities/*.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" \"tests/**/*.ts\" \"*.ts\" \"*.json\" \"src-tauri/*.json\" \"src-tauri/capabilities/*.json\""
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "prettier": "^3.9.10",
    "typescript": "^5.9",
    "vite": "^7",
    "vitest": "^5.0.3"
  }
}
