{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Local task windows: window controls, events, and folder/icon picker.",
  "windows": ["main", "reminder", "popup", "widget", "settings"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-size",
    "core:window:allow-set-focus",
    "dialog:allow-open"
  ]
}
