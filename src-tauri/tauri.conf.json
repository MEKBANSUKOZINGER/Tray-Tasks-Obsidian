{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tray Tasks",
  "version": "0.3.0",
  "identifier": "com.traytasks.obsidian",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tray Tasks",
        "width": 320,
        "height": 240,
        "minWidth": 0,
        "minHeight": 0,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "shadow": false,
        "dragDropEnabled": false
      },
      {
        "label": "reminder",
        "title": "Tray Tasks Reminder",
        "url": "index.html?window=reminder",
        "width": 320,
        "height": 260,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "shadow": false,
        "dragDropEnabled": false
      },
      {
        "label": "popup",
        "title": "Tray Tasks Popup",
        "url": "index.html?window=popup",
        "width": 320,
        "height": 235,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "shadow": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "An Obsidian daily-note task list in your Windows tray.",
    "category": "Productivity",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "languages": ["English", "Korean"]
      }
    }
  }
}
